# MongoDB Atlas connection string
# Replace <username>, <password>, and <cluster> with your Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/simfraud_db?retryWrites=true&w=majority

# Server port
PORT=5000

# Ollama AI service URL (use http://ollama:11434 inside Docker, http://localhost:11434 locally)
OLLAMA_URL=http://ollama:11434/api/generate

# Fast2SMS API key for simulated SMS
